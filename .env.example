APP_NAME=API-IAM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Dirección pública (detrás del proxy, la de afuera): de aquí sale la redirect_uri del login
APP_URL=http://localhost:4200

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

# Igual que API-Auth: valida con Hash::check las contraseñas y secretos que escribe API-IAM
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base IAM, compartida con API-Auth (cada tabla tiene un solo dueño; ver CLAUDE.md)
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=IAM
DB_USERNAME=apiiam_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Sesión y caché en archivos: las tablas sessions, cache y jobs de la base son de API-Auth.
# Un solo contenedor; un despliegue nuevo cierra las sesiones del portal.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Detrás de ubo-nginx-proxy: IP o CIDR del proxy, o * para confiar en cualquiera
TRUSTED_PROXIES=*

# --- ubo/common ---
# IAM (API-Auth): interna, de servidor a servidor
UBO_AUTH_URL=https://apidev.ubo.cl
# Cliente M2M de API-IAM (iam-admin-sistema): revocación de sesiones e introspección.
# Lo crea iam:install y lo muestra una sola vez.
UBO_AUTH_CLIENT_ID=
UBO_AUTH_CLIENT_SECRET=
# Revalidación de la sesión del portal contra IAM (una persona dada de baja pierde el acceso en minutos)
UBO_AUTH_STRATEGY=hybrid
UBO_AUTH_DEGRADED_MODE=false

# Login del portal (BFF): rutas /api/iam/v1/auth/{login,callback,logout}.
# APP_URL debe ser el origen del Angular: la redirect_uri es APP_URL + /api/iam/v1/auth/callback
UBO_COMMON_LOGIN=true
UBO_LOGIN_ROUTE_PREFIX=api/iam/v1/auth
# IAM como la abre el navegador
UBO_LOGIN_PUBLIC_URL=https://apidev.ubo.cl
# Cliente authorization-code del portal (iam-admin-portal). Lo crea iam:install.
UBO_LOGIN_CLIENT_ID=
UBO_LOGIN_CLIENT_SECRET=
UBO_LOGIN_HOME=/
UBO_LOGIN_STORE=file
UBO_LOGIN_REVALIDATE=300

# Horas de vigencia de una contraseña temporal
IAM_CLAVE_TEMPORAL_HORAS=72

# --- Docker ---
# DOCKER_HTTP_PORT=8003
# SQL Server de los tests (perfil tests): contraseña local del usuario sa
DOCKER_MSSQL_SA_PASSWORD=
# DOCKER_MSSQL_PORT=14335
