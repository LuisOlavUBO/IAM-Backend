meta {
  name: Listar usuarios
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/iam/v1/usuarios?buscar=&estado=todos&pagina=1&por_pagina=20
  body: none
  auth: none
}

params:query {
  buscar: 
  estado: todos
  pagina: 1
  por_pagina: 20
  ~inactivas: 90
}

headers {
  Cookie: {{sessionCookie}}
}

tests {
  test("lista personas paginadas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.all.keys("total", "pagina", "por_pagina");
  });
}

docs {
  # Listar usuarios

  `GET /api/iam/v1/usuarios` · sesión del portal · `iam:usuarios.leer`

  Personas ordenadas por nombre. `buscar` filtra por nombre o correo (sin distinguir mayúsculas) o por un RUT válido, con o sin puntos. `estado`: `activos`, `baja` o `todos`. `inactivas`: `30`, `90` o `nunca` (sin actividad hace más de 30 o 90 días, o nunca; la actividad es el último token emitido, como en Indicadores). `por_pagina` de 1 a 100 (20 por omisión).

  ## Respuesta 200

  ```json
  {
    "data": [
      { "uuid": "0190f2a4-3c1e-7d2b-9a6f-1b2c3d4e5f60", "nombre": "Ana Pérez", "correo": "ana@ubo.cl", "rut": "12345678-5", "estado": "activo" }
    ],
    "meta": { "total": 1, "pagina": 1, "por_pagina": 20 }
  }
  ```

  ## Errores

  401 `NO_AUTENTICADO`, 403 `ACCESO_DENEGADO`, 422 `VALIDACION` (con `errores` por campo).
}
