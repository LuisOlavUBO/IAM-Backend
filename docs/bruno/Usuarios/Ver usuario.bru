meta {
  name: Ver usuario
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/iam/v1/usuarios/{{usuarioUuid}}
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

vars:pre-request {
  usuarioUuid: 0190f2a4-3c1e-7d2b-9a6f-1b2c3d4e5f60
}

tests {
  test("trae la persona con sus roles por aplicación", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.uuid).to.match(/^[0-9a-f-]{36}$/);
    expect(res.body.data.aplicaciones).to.be.an("array");
  });
}

docs {
  # Ver usuario

  `GET /api/iam/v1/usuarios/{uuid}` · sesión del portal · `iam:usuarios.leer`

  Cambiar `usuarioUuid` por el `uuid` de una persona del listado.

  ## Respuesta 200

  ```json
  {
    "data": {
      "uuid": "0190f2a4-3c1e-7d2b-9a6f-1b2c3d4e5f60",
      "nombre": "Ana Pérez",
      "correo": "ana@ubo.cl",
      "rut": "12345678-5",
      "estado": "activo",
      "baja_desde": null,
      "tiene_clave": false,
      "microsoft_vinculado": true,
      "clave_temporal_vence": null,
      "creado": "2026-11-01T10:00:00+00:00",
      "actualizado": "2026-11-02T11:30:00+00:00",
      "aplicaciones": [
        { "nombre": "iam-admin", "descripcion": "Portal de administración de IAM", "roles": [ { "nombre": "administrador", "descripcion": null } ] }
      ]
    }
  }
  ```

  ## Errores

  401 `NO_AUTENTICADO`, 403 `ACCESO_DENEGADO`, 404 `USUARIO_NO_ENCONTRADO` (no existe o no es un UUID).
}
