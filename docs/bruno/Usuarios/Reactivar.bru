meta {
  name: Reactivar
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/iam/v1/usuarios/{{usuarioUuid}}/reactivacion
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
  X-XSRF-TOKEN: {{xsrfToken}}
  Accept: application/json
}

vars:pre-request {
  usuarioUuid: 0190f2a4-3c1e-7d2b-9a6f-1b2c3d4e5f60
}

tests {
  test("la persona queda activa", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.activo).to.equal(true);
  });
}

docs {
  # Reactivar

  `POST /api/iam/v1/usuarios/{uuid}/reactivacion` · sesión del portal · `iam:usuarios.administrar` · CSRF

  Quita `disabled_at`; la persona conserva sus roles (auditoría `usuario.alta`). Si ya estaba activa, no cambia nada.

  ```json
  { "data": { "activo": true } }
  ```

  ## Errores

  401; 403 `ACCESO_DENEGADO`, `ESCALAMIENTO_DE_PRIVILEGIOS` o `ACCION_SOBRE_SI_MISMO`; 404 `USUARIO_NO_ENCONTRADO`; 419 sin CSRF.
}
