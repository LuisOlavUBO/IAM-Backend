meta {
  name: Listar clientes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/iam/v1/clientes?buscar=&pagina=1&por_pagina=20
  body: none
  auth: none
}

params:query {
  buscar:
  pagina: 1
  por_pagina: 20
}

headers {
  Cookie: {{sessionCookie}}
}

script:post-response {
  // Deja el primer cliente listo para "Ver cliente".
  if (res.status === 200 && res.body.data.length > 0) {
    bru.setVar("clienteId", res.body.data[0].id);
  }
}

tests {
  test("lista clientes paginados sin secreto", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.all.keys("total", "pagina", "por_pagina");
    res.body.data.forEach((cliente) => expect(cliente).to.not.have.property("secret"));
  });
}

docs {
  # Listar clientes

  `GET /api/iam/v1/clientes` · sesión del portal · `iam:clientes.leer`

  `buscar` filtra por el nombre del cliente o de su aplicación (sin distinguir mayúsculas); si es un UUID, trae además el cliente con ese id. Incluye los revocados.

  ## Respuesta 200

  ```json
  {
    "data": [
      { "id": "0199a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b", "nombre": "iam-admin-sistema", "aplicacion": "iam-admin", "revocado": false, "roles": 2 }
    ],
    "meta": { "total": 1, "pagina": 1, "por_pagina": 20 }
  }
  ```

  ## Errores

  401 `NO_AUTENTICADO`, 403 `ACCESO_DENEGADO`, 422 `VALIDACION`.
}
