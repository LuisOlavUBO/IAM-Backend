meta {
  name: Editar rol
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/iam/v1/aplicaciones/{{aplicacionNombre}}/roles/{{rolNombre}}
  body: json
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
  X-XSRF-TOKEN: {{xsrfToken}}
  Accept: application/json
}

vars:pre-request {
  aplicacionNombre: biblioteca
  rolNombre: bibliotecario
}

body:json {
  {
    "descripcion": "Presta y recibe libros"
  }
}

tests {
  test("cambia la descripción", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.descripcion).to.equal("Presta y recibe libros");
  });
}

docs {
  # Editar rol

  `PATCH /api/iam/v1/aplicaciones/{nombre}/roles/{rol}` · sesión del portal · `iam:aplicaciones.administrar` · CSRF

  Cuerpo `{ descripcion }` (vacía o `null` la borra). El nombre no se cambia; si lleva espacios, codifíquelos en la URL (`%20`). Queda en la auditoría como `rol.edicion` con la descripción anterior y la nueva; la misma descripción responde 200 sin cambios ni auditoría.

  200 `{ "data": { "nombre": "bibliotecario", "descripcion": "Presta y recibe libros" } }`

  ## Errores

  401 `NO_AUTENTICADO`; 403 `ACCESO_DENEGADO`; 404 `APLICACION_NO_ENCONTRADA` o `ROL_NO_ENCONTRADO`; 409 `CATALOGO_DE_IAM_ADMIN`; 419 sin CSRF; 422 `VALIDACION`.
}
